# 复制为 .env 后填写；.env 已在 .gitignore 中，严禁提交私钥
BSC_RPC_URL=https://bsc-dataseed.binance.org
# 部署用（仅部署时需要，严禁写进仓库）
DEPLOYER_PRIVATE_KEY=
# 部署参数（见 script/Deploy.s.sol）
OWNER=0xEeccBF3A2B2BE808C69d3209516a1b7abf7AF81C   # Matt 的 MetaMask，与主网 vault owner 同一地址（2026-09-05 决定：单一 EOA，不用多签）
LP_RECIPIENT=0x000000000000000000000000000000000000dEaD   # Matt 2026-09-04 决定：LP 销毁（黑洞地址），不锁仓
ALLOW_EOA_LP_RECIPIENT=false
THRESHOLD_PTC=3000      # 试运行阶段（Matt 2026-09-05）：约一天的手续费；跑顺后 setConfig 调到 50000
BURN_BPS=3000
CALLER_INCENTIVE_BPS=30
MIN_INCENTIVE_PTC=30
SLIPPAGE_BPS=150
MIN_INTERVAL_SECONDS=3600
TWAP_WINDOW_SECONDS=1800
MAX_TWAP_DEVIATION_BPS=300
